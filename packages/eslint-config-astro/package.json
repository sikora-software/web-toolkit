{
  "name": "@sikora-software/eslint-config-astro",
  "version": "0.1.3",
  "description": "Shared ESLint configuration for Astro projects using TypeScript and ESLint flat config.",
  "author": "Mateusz Sikora (https://sikora.software)",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
