    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "typescript-eslint": "^8.68.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sikora-software/web-toolkit.git",
    "directory": "packages/eslint-config-astro"
